<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Strategy 8 — the "20SMA 15min candle" rule (STRATEGIES.md, "Strategy 8";
      STRATEGY_ANALYSIS_TODO.md S29).

      Two nullable columns
      ====================
      strategy_defaults.trail_atr_multiple — per-strategy switch for the
      chandelier trail: PositionService floors the stop at
      peak_profit − (multiple × ATR of the signal bar). Null keeps the
      ladder / fixed-stop behaviour of strategies 1-7 untouched.
      trade_order.trail_atr_distance_at_entry — that distance in points, frozen
      onto the row at entry for the same reason the bracket and the ladder are
      (036/043): the monitor must not depend on a config cache after a restart,
      and a defaults edit at 13:00 must not re-floor a trade opened at 09:20.

      The seed row
      ============
      Copied from strategy 1's block (transaction_type SELL, lot, max_loss,
      no_of_trades, no_of_parallel_trades, auto_config_enabled, sl_mode) with
      target_mode = NONE (the replay's chandelier variant had no profit target;
      a 20% target turned it into the "bracket" rows of the study, +0.3 to +0.9
      a trade) and trail_atr_multiple = 2.00 (k = 1.5 … 4 were flat, 2 had the
      best trade count / drawdown pairing). opposite_side FALSE: it sells the
      leg it scans.

      What it does NOT do
      ===================
      No sma_downtrend_rule_strategy tag, so nothing trades until an operator
      says so (CLAUDE.md Rule 0(c)):
          INSERT INTO sma_downtrend_rule_strategy (rule_id, strategy_id, enabled)
          SELECT rs.rule_id, 8, TRUE
            FROM sma_downtrend_rule_strategy rs
           WHERE rs.strategy_id = 1 AND rs.enabled = TRUE;
      A no-op on a database without a strategy 1 row (insert 8 by hand then,
      docs/EOD_DOWNTREND.md "strategy_defaults") and when 8 already exists.
    -->
    <changeSet id="048_strategy8_atr_trail_columns" author="moneymaker">
        <addColumn tableName="strategy_defaults">
            <column name="trail_atr_multiple" type="DECIMAL(6,2)"/>
        </addColumn>
        <addColumn tableName="trade_order">
            <column name="trail_atr_distance_at_entry" type="DECIMAL(12,4)"/>
        </addColumn>
    </changeSet>

    <changeSet id="048_seed_strategy8_defaults" author="moneymaker">
        <sql>
            INSERT INTO strategy_defaults
                (strategy_id, transaction_type, lot_quantity, max_loss,
                 no_of_trades, no_of_parallel_trades, auto_config_enabled, opposite_side,
                 target_mode, sl_mode, trail_atr_multiple)
            SELECT 8, s.transaction_type, s.lot_quantity, s.max_loss,
                   s.no_of_trades, s.no_of_parallel_trades, s.auto_config_enabled, FALSE,
                   'NONE', s.sl_mode, 2.00
              FROM strategy_defaults s
             WHERE s.strategy_id = 1
               AND NOT EXISTS (SELECT 1 FROM strategy_defaults x WHERE x.strategy_id = 8)
        </sql>
    </changeSet>
</databaseChangeLog>
