<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001_create_instrument_table" author="moneymaker">
        <createTable tableName="instrument">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ins_name" type="VARCHAR(255)"/>
            <column name="ins_id" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="lot_qty" type="INT"/>
            <column name="strike_points" type="DECIMAL(19,2)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>

