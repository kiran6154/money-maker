<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
        Stamps each market_data row with its underlying index name — "NIFTY",
        "BANKNIFTY", "FINNIFTY", etc. — so the bulk download can be invoked
        per-underlying and the table can host data for multiple underlyings
        side-by-side without ambiguity. Nullable so old rows survive; the
        bulk-download endpoint now populates it on every refresh.

        PreCondition skips the add if the column already exists (e.g. user
        added it manually before this changeset landed).
    -->
    <changeSet id="017_add_underlying_name_to_market_data" author="moneymaker">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="market_data" columnName="underlying_name"/>
            </not>
        </preConditions>
        <addColumn tableName="market_data">
            <column name="underlying_name" type="VARCHAR(32)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
