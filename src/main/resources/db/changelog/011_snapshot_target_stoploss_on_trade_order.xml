<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="011_snapshot_target_stoploss_on_trade_order" author="moneymaker">
        <addColumn tableName="trade_order">
            <!-- Per-share profit target snapshotted from trade_config at order open. -->
            <column name="target_at_entry"     type="DECIMAL(12,4)"/>
            <!-- Per-share stop-loss (positive) snapshotted from trade_config at order open. -->
            <column name="stop_loss_at_entry"  type="DECIMAL(12,4)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
