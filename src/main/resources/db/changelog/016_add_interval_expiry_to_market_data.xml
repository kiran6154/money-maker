<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
        Phase 3 (backtest performance): mark each market_data row with its
        candle interval ("5minute" / "10minute" / "15minute") and (for options)
        its expiry date. Both nullable so existing rows survive; the bulk
        download will populate them on the next refresh.

        Why interval matters: prior to this column the table mixed 5/10/15-min
        candles for the same instrumenttoken with no way to distinguish them.
        Backtest reads filtered by (token, interval, time range) so the
        column is mandatory for a DB-backed market data source.

        `precondition` skips the addColumn if the column was already created
        manually (the user added expiry_date out-of-band before this changeset
        was authored). Otherwise Liquibase would refuse to start.
    -->
    <changeSet id="016_add_interval_to_market_data" author="moneymaker">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="market_data" columnName="candle_interval"/>
            </not>
        </preConditions>
        <addColumn tableName="market_data">
            <!-- Named candle_interval (not 'interval') because INTERVAL is a
                 MySQL reserved word and unquoted DDL/JPA would fail. -->
            <column name="candle_interval" type="VARCHAR(16)"/>
        </addColumn>
    </changeSet>

    <changeSet id="016_add_expiry_date_to_market_data" author="moneymaker">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="market_data" columnName="expiry_date"/>
            </not>
        </preConditions>
        <addColumn tableName="market_data">
            <column name="expiry_date" type="DATE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
